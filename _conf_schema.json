{
    "terminal": {
        "description": "交互式终端",
        "type": "object",
        "hint": "给 LLM 使用的持久终端会话能力。默认关闭，启用前请确认安全边界。",
        "items": {
            "enabled": {
                "description": "启用终端工具",
                "hint": "默认关闭。开启后 LLM 才能调用 terminal 工具。",
                "type": "bool",
                "default": false
            },
            "admin_only": {
                "description": "仅管理员可用",
                "hint": "建议保持开启。若无法从事件确认管理员身份，请填写 admin_user_ids。",
                "type": "bool",
                "default": true
            },
            "admin_user_ids": {
                "description": "允许使用的用户 ID",
                "hint": "当 AstrBot 事件无法确认管理员身份时，用这里的用户 ID 作为安全白名单。",
                "type": "list",
                "items": {"type": "string"},
                "default": []
            },
            "allow_group": {
                "description": "允许群聊调用",
                "hint": "默认禁用。交互终端建议只在私聊中使用。",
                "type": "bool",
                "default": false
            },
            "max_sessions": {
                "description": "最大会话数",
                "hint": "同时存在的终端会话数量上限。",
                "type": "int",
                "default": 2
            },
            "idle_ttl_seconds": {
                "description": "空闲回收秒数",
                "hint": "会话超过该时长无操作后自动关闭。",
                "type": "int",
                "default": 600
            },
            "max_output_chars": {
                "description": "屏幕输出字符上限",
                "hint": "返回给 LLM 的 screen 最大字符数。",
                "type": "int",
                "default": 8000
            },
            "max_recent_chars": {
                "description": "增量输出字符上限",
                "hint": "返回给 LLM 的 recent_output 最大字符数。",
                "type": "int",
                "default": 4000
            },
            "max_input_chars": {
                "description": "单次输入字符上限",
                "hint": "限制 LLM 每次 send 可写入终端的文本长度。",
                "type": "int",
                "default": 4000
            },
            "default_command": {
                "description": "默认终端命令",
                "hint": "start 未指定 command 时使用。留空则按平台自动选择：Linux/macOS 优先 $SHELL/bash/sh，Windows 使用 powershell。",
                "type": "string",
                "default": ""
            },
            "allowed_commands": {
                "description": "启动命令额外白名单",
                "hint": "可选。非空时才限制 start command 的第一个可执行文件名；留空表示不额外限制启动命令，由 command_permission_mode 决定是否放行。",
                "type": "list",
                "items": {"type": "string"},
                "default": []
            },
            "backend_mode": {
                "description": "终端后端",
                "hint": "auto=Linux/macOS 优先 tmux，缺失时回退 pty；pty=自建 PTY；tmux=强制使用 tmux 后端，更适合 ssh/sudo/TUI 交互。",
                "type": "string",
                "default": "auto",
                "options": ["auto", "pty", "tmux"]
            },
            "default_cwd": {
                "description": "默认工作目录",
                "hint": "留空表示不指定默认目录，由 AstrBot 进程/终端后端决定当前目录。",
                "type": "string",
                "default": ""
            },
            "cwd_allowlist": {
                "description": "允许的工作目录根",
                "hint": "非空时，显式传入的 cwd 必须位于这些目录内。留空表示不限制 cwd。",
                "type": "list",
                "items": {"type": "string"},
                "default": []
            },
            "command_permission_mode": {
                "description": "命令权限模式",
                "hint": "allow_all=所有命令放行；admin_only=仅管理员命令放行；blacklist=仅拦截黑名单命令。",
                "type": "string",
                "default": "blacklist",
                "options": ["allow_all", "admin_only", "blacklist"]
            },
            "command_blacklist": {
                "description": "命令黑名单",
                "hint": "command_permission_mode=blacklist 时生效；命中这些片段的 start command 或 send text 会被拒绝。",
                "type": "list",
                "items": {"type": "string"},
                "default": []
            },
            "audit_enabled": {
                "description": "启用审计日志",
                "hint": "记录 action、会话 ID、输入摘要、输出长度，不完整保存全部输出。",
                "type": "bool",
                "default": true
            },
            "quiet_ms": {
                "description": "输出安静毫秒数",
                "hint": "wait=true 时，插件等待终端输出停止变化 quiet_ms 后返回。",
                "type": "int",
                "default": 200
            },
            "max_wait_ms": {
                "description": "自动等待上限毫秒数",
                "hint": "wait=true 时最多等待这么久，避免无输出命令一直卡住。",
                "type": "int",
                "default": 3000
            },
            "input_chunk_chars": {
                "description": "输入分块字符数",
                "hint": "长命令会按块写入，减少 Windows/PTY 输入截断概率。",
                "type": "int",
                "default": 128
            },
            "input_chunk_delay_ms": {
                "description": "输入分块间隔毫秒数",
                "hint": "每写入一块长文本后等待的时间。",
                "type": "int",
                "default": 10
            }
        }
    }
}
